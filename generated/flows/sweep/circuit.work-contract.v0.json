  "work_contract": {
    "flow": {
      "id": "sweep",
      "version": "0.1.0",
      "purpose": "Sweep flow: clear a whole backlog of one mechanical finding by partitioning it into file-disjoint units, fanning a worker out per unit, and re-scanning with a pinned oracle each wave until the scanner exits clean or the iteration cap is hit.",
      "axes": {
        "allowed_depths": ["medium"],
        "supports_tournament": false,
        "supports_autonomous": true,
        "default": {
          "depth": "medium",
          "tournament": false,
          "tournament_n": 3,
          "autonomous": false
        }
      },
      "starts_at": "census-step"
    },
    "topology": {
      "stages": [
        {
          "id": "plan-stage",
          "title": "Census and partition",
          "canonical": "plan",
          "steps": ["census-step", "partition-step"]
        },
        {
          "id": "act-stage",
          "title": "Fix",
          "canonical": "act",
          "steps": ["fanout-step"]
        },
        {
          "id": "verify-stage",
          "title": "Rescan",
          "canonical": "verify",
          "steps": ["rescan-step"]
        },
        {
          "id": "review-stage",
          "title": "Review",
          "canonical": "review",
          "steps": ["judge-step"]
        }
      ],
      "stage_path_policy": {
        "mode": "partial",
        "omits": ["frame", "analyze", "close"],
        "rationale": "Sweep is a fan-out-over-a-set Converge flow: it plans the sweep (census plus partition), acts on it (the fan-out wave), verifies with a pinned rescan, and reviews whether the backlog is clear, looping the body until the scanner exits clean."
      },
      "routes": [
        {
          "step_id": "census-step",
          "route_id": "continue",
          "target": "partition-step"
        },
        {
          "step_id": "census-step",
          "route_id": "pass",
          "target": "partition-step"
        },
        {
          "step_id": "census-step",
          "route_id": "stop",
          "target": "@stop"
        },
        {
          "step_id": "partition-step",
          "route_id": "continue",
          "target": "fanout-step"
        },
        {
          "step_id": "partition-step",
          "route_id": "pass",
          "target": "fanout-step"
        },
        {
          "step_id": "partition-step",
          "route_id": "stop",
          "target": "@stop"
        },
        {
          "step_id": "fanout-step",
          "route_id": "continue",
          "target": "rescan-step"
        },
        {
          "step_id": "fanout-step",
          "route_id": "pass",
          "target": "rescan-step"
        },
        {
          "step_id": "fanout-step",
          "route_id": "stop",
          "target": "@stop"
        },
        {
          "step_id": "rescan-step",
          "route_id": "continue",
          "target": "judge-step"
        },
        {
          "step_id": "rescan-step",
          "route_id": "pass",
          "target": "judge-step"
        },
        {
          "step_id": "rescan-step",
          "route_id": "revise",
          "target": "judge-step"
        },
        {
          "step_id": "rescan-step",
          "route_id": "stop",
          "target": "@stop"
        },
        {
          "step_id": "judge-step",
          "route_id": "continue",
          "target": "@complete"
        },
        {
          "step_id": "judge-step",
          "route_id": "pass",
          "target": "@complete"
        },
        {
          "step_id": "judge-step",
          "route_id": "advance",
          "target": "partition-step"
        },
        {
          "step_id": "judge-step",
          "route_id": "close",
          "target": "@stop"
        }
      ]
    },
    "blocks": [
      {
        "step_id": "census-step",
        "title": "Census the backlog",
        "kind": "compose",
        "executor": "orchestrator",
        "protocol": "sweep-census@v1",
        "reads": [],
        "writes": {
          "report": {
            "path": "reports/sweep/census.json",
            "schema": "sweep.census@v1"
          }
        },
        "check": {
          "kind": "schema_sections",
          "source": {
            "kind": "report",
            "ref": "report"
          },
          "required": ["objective", "scanner", "suppression_audit", "findings"]
        },
        "routes": {
          "continue": "partition-step",
          "pass": "partition-step",
          "stop": "@stop"
        }
      },
      {
        "step_id": "partition-step",
        "title": "Partition the survivors",
        "kind": "compose",
        "executor": "orchestrator",
        "protocol": "sweep-partition@v1",
        "reads": ["reports/sweep/census.json", "reports/sweep/carried-notes.json"],
        "writes": {
          "report": {
            "path": "reports/sweep/partition.json",
            "schema": "sweep.partition@v1"
          }
        },
        "check": {
          "kind": "schema_sections",
          "source": {
            "kind": "report",
            "ref": "report"
          },
          "required": ["units"]
        },
        "routes": {
          "continue": "fanout-step",
          "pass": "fanout-step",
          "stop": "@stop"
        }
      },
      {
        "step_id": "fanout-step",
        "title": "Fix each unit",
        "kind": "fanout",
        "executor": "orchestrator",
        "protocol": "sweep-fanout@v1",
        "reads": ["reports/sweep/partition.json"],
        "writes": {
          "branches_dir": "reports/sweep/wave-branches",
          "aggregate": {
            "path": "reports/sweep/wave-aggregate.json",
            "schema": "sweep.wave-aggregate@v1"
          }
        },
        "check": {
          "kind": "fanout_aggregate",
          "source": {
            "kind": "fanout_results",
            "ref": "aggregate"
          },
          "join": {
            "policy": "aggregate-only"
          },
          "verdicts": {
            "admit": ["fixed", "partial", "blocked"]
          }
        },
        "routes": {
          "continue": "rescan-step",
          "pass": "rescan-step",
          "stop": "@stop"
        }
      },
      {
        "step_id": "rescan-step",
        "title": "Re-scan for remaining findings",
        "kind": "verification",
        "executor": "orchestrator",
        "protocol": "sweep-rescan@v1",
        "reads": ["reports/sweep/census.json"],
        "writes": {
          "report": {
            "path": "reports/sweep/rescan.json",
            "schema": "sweep.verification@v1"
          }
        },
        "check": {
          "kind": "schema_sections",
          "source": {
            "kind": "report",
            "ref": "report"
          },
          "required": ["overall_status", "commands"]
        },
        "routes": {
          "continue": "judge-step",
          "pass": "judge-step",
          "revise": "judge-step",
          "stop": "@stop"
        }
      },
      {
        "step_id": "judge-step",
        "title": "Judge whether the backlog is clear",
        "kind": "relay",
        "executor": "worker",
        "protocol": "sweep-review@v1",
        "reads": [],
        "writes": {
          "report": {
            "path": "reports/sweep/judgment.report.json",
            "schema": "converge.judgment@v1"
          },
          "request": "reports/sweep/judgment.request.json",
          "receipt": "reports/sweep/judgment.receipt.txt",
          "result": "reports/sweep/judgment.result.json"
        },
        "check": {
          "kind": "result_verdict",
          "source": {
            "kind": "relay_result",
            "ref": "result"
          },
          "pass": ["accept", "accept-with-fixes", "reject"]
        },
        "routes": {
          "continue": "@complete",
          "pass": "@complete",
          "advance": "partition-step",
          "close": "@stop"
        }
      }
    ],
    "authority": {
      "relays": [
        {
          "step_id": "judge-step",
