{
  "schema_version": "3",
  "id": "explainer",
  "version": "0.1.0",
  "purpose": "Explainer flow: turn a research paper into an interactive web explainer. Frame the subject, build a lossless digest, ideate persona-lensed concepts, run a six-criteria tournament, harden the survivors against teaching the wrong driver, take an operator pick, write a house-style spec, run a child build, verify the site, take an operator fidelity sign-off, and close honestly.",
  "axes": {
    "allowed_depths": ["low", "medium", "high"],
    "supports_tournament": true,
    "supports_autonomous": true,
    "default": {
      "depth": "medium",
      "tournament": false,
      "tournament_n": 3,
      "autonomous": false
    },
    "tournament_fan_out_stage": "plan-stage"
  },
  "starts_at": "intake-step",
  "stages": [
    {
      "id": "frame-stage",
      "title": "Frame",
      "canonical": "frame",
      "steps": ["intake-step"]
    },
    {
      "id": "analyze-stage",
      "title": "Digest",
      "canonical": "analyze",
      "steps": ["digest-step"]
    },
    {
      "id": "plan-stage",
      "title": "Ideate & Choose",
      "canonical": "plan",
      "steps": [
        "ideas-step",
        "tournament-step",
        "hardening-step",
        "pick-checkpoint-step",
        "spec-step"
      ]
    },
    {
      "id": "act-stage",
      "title": "Build",
      "canonical": "act",
      "steps": ["build-step"]
    },
    {
      "id": "verify-stage",
      "title": "Verify",
      "canonical": "verify",
      "steps": ["verify-step"]
    },
    {
      "id": "review-stage",
      "title": "Sign Off",
      "canonical": "review",
      "steps": ["signoff-checkpoint-step"]
    },
    {
      "id": "close-stage",
      "title": "Close",
      "canonical": "close",
      "steps": ["close-step"]
    }
  ],
  "stage_path_policy": {
    "mode": "strict"
  },
  "steps": [
    {
      "id": "intake-step",
      "title": "Frame — produce explainer.intake",
      "protocol": "explainer-intake@v1",
      "reads": [],
      "routes": {
        "continue": "digest-step",
        "pass": "digest-step",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "compose",
      "writes": {
        "report": {
          "path": "reports/intake.json",
          "schema": "explainer.intake@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": ["subject", "success_condition"]
      }
    },
    {
      "id": "digest-step",
      "title": "Digest — produce the lossless outline",
      "protocol": "explainer-digest@v1",
      "reads": ["reports/intake.json"],
      "routes": {
        "continue": "ideas-step",
        "pass": "ideas-step",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "compose",
      "writes": {
        "report": {
          "path": "reports/digest.json",
          "schema": "explainer.digest@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": ["lossless_principle", "outline_sections"]
      }
    },
    {
      "id": "ideas-step",
      "title": "Ideate — draft persona-lensed concepts",
      "protocol": "explainer-ideas@v1",
      "reads": ["reports/intake.json", "reports/digest.json"],
      "routes": {
        "continue": "tournament-step",
        "pass": "tournament-step",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "compose",
      "writes": {
        "report": {
          "path": "reports/ideas.json",
          "schema": "explainer.ideas@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": ["brief_question", "concepts"]
      }
    },
    {
      "id": "tournament-step",
      "title": "Tournament — fan out one advocate per concept",
      "protocol": "explainer-tournament@v1",
      "reads": ["reports/intake.json", "reports/ideas.json"],
      "routes": {
        "continue": "hardening-step",
        "pass": "hardening-step",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "fanout",
      "branches": {
        "kind": "dynamic",
        "source_report": "reports/ideas.json",
        "items_path": "concepts",
        "template": {
          "branch_id": "$item.id",
          "execution": {
            "kind": "relay",
            "role": "researcher",
            "goal": "$item.scoped_prompt",
            "report_schema": "explainer.tournament-proposal@v1",
            "provenance_field": "concept_id"
          }
        },
        "max_branches": {
          "kind": "axis",
          "axis": "tournament_n"
        },
        "required_count": {
          "kind": "axis",
          "axis": "tournament_n"
        }
      },
      "concurrency": {
        "kind": "bounded",
        "max": 2
      },
      "on_child_failure": "continue-others",
      "rubric": {
        "model_judgments_path": "rubric_model_judgments",
        "ordered_dims": [
          "fidelity",
          "memetic_potential",
          "entertainment",
          "cross_audience_reach",
          "build_feasibility",
          "novelty"
        ],
        "runtime_signals": {
          "fidelity": {
            "kind": "non_empty_array",
            "path": "fidelity_evidence"
          },
          "memetic_potential": {
            "kind": "constant",
            "signal": "n/a"
          },
          "entertainment": {
            "kind": "constant",
            "signal": "n/a"
          },
          "cross_audience_reach": {
            "kind": "constant",
            "signal": "n/a"
          },
          "build_feasibility": {
            "kind": "non_empty_string",
            "path": "next_action"
          },
          "novelty": {
            "kind": "constant",
            "signal": "n/a"
          }
        }
      },
      "writes": {
        "branches_dir": "reports/tournament-branches",
        "aggregate": {
          "path": "reports/tournament-aggregate.json",
          "schema": "explainer.tournament-aggregate@v1"
        }
      },
      "check": {
        "kind": "fanout_aggregate",
        "source": {
          "kind": "fanout_results",
          "ref": "aggregate"
        },
        "join": {
          "policy": "aggregate-survivors"
        },
        "verdicts": {
          "admit": ["accept"]
        }
      }
    },
    {
      "id": "hardening-step",
      "title": "Harden — adversarial fidelity pass over survivors",
      "protocol": "explainer-hardening@v1",
      "reads": ["reports/intake.json", "reports/ideas.json", "reports/tournament-aggregate.json"],
      "routes": {
        "continue": "pick-checkpoint-step",
        "pass": "pick-checkpoint-step",
        "stop": "@stop"
      },
      "skill_slots": [
        {
          "id": "explainer-fidelity-audit",
          "description": "A skill for adversarially checking each finalist concept against the paper, catching any that would teach the seductive wrong driver instead of the real one."
        }
      ],
      "executor": "worker",
      "kind": "relay",
      "role": "reviewer",
      "writes": {
        "report": {
          "path": "reports/hardening.json",
          "schema": "explainer.hardening@v1"
        },
        "request": "reports/relay/hardening.request.json",
        "receipt": "reports/relay/hardening.receipt.txt",
        "result": "reports/relay/hardening.result.json"
      },
      "check": {
        "kind": "result_verdict",
        "source": {
          "kind": "relay_result",
          "ref": "result"
        },
        "pass": ["recommend", "no-clear-winner", "needs-operator"]
      }
    },
    {
      "id": "pick-checkpoint-step",
      "title": "Pick — operator chooses a concept to build",
      "protocol": "explainer-pick-checkpoint@v1",
      "reads": ["reports/hardening.json", "reports/tournament-aggregate.json"],
      "routes": {
        "continue": "spec-step",
        "pass": "spec-step",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "checkpoint",
      "policy": {
        "prompt": "Choose the concept Circuit should build into the explainer site. The hardening pass recommends one survivor; you decide. This checkpoint only records a concept choice.",
        "choices_from": {
          "kind": "report_items",
          "source_report": "reports/tournament-aggregate.json",
          "items_path": "branches",
          "filter": {
            "kind": "path_equals",
            "path": "child_outcome",
            "value": "complete"
          },
          "id_path": "branch_id",
          "label_path": "result_body.concept_label",
          "description_path": "result_body.case_summary"
        },
        "safe_default_choice": "concept-1",
        "auto_resolution": {
          "policy": "highest-score",
          "source_report": "reports/tournament-aggregate.json",
          "branches_path": "branches",
          "id_path": "branch_id",
          "rubric_result_path": "rubric_result"
        }
      },
      "writes": {
        "request": "reports/checkpoints/pick-request.json",
        "response": "reports/checkpoints/pick-response.json"
      },
      "check": {
        "kind": "checkpoint_selection",
        "source": {
          "kind": "checkpoint_response",
          "ref": "response"
        },
        "allow_from": {
          "kind": "policy_choices"
        }
      }
    },
    {
      "id": "spec-step",
      "title": "Spec — assemble the house-style build law",
      "protocol": "explainer-spec@v1",
      "reads": [
        "reports/intake.json",
        "reports/ideas.json",
        "reports/tournament-aggregate.json",
        "reports/hardening.json"
      ],
      "routes": {
        "continue": "build-step",
        "pass": "build-step",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "compose",
      "writes": {
        "report": {
          "path": "reports/explainer/spec.json",
          "schema": "explainer.spec@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": ["concept_id", "build_brief", "fidelity_citations"]
      }
    },
    {
      "id": "build-step",
      "title": "Build — run the child build flow on the spec",
      "protocol": "explainer-build@v1",
      "reads": ["reports/explainer/spec.json"],
      "routes": {
        "continue": "verify-step",
        "pass": "verify-step",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "sub-run",
      "flow_ref": {
        "flow_id": "build",
        "entry_mode": "default"
      },
      "goal": "Build the interactive web explainer described in reports/explainer/spec.json. Honor the house-style specs and teach the paper’s actual driver, never the seductive wrong one. Produce a locally building site; do not deploy.",
      "depth": "medium",
      "writes": {
        "result": "reports/explainer/build-result.json",
        "report": {
          "path": "reports/explainer/build-result.json",
          "schema": "explainer.build-result@v1"
        }
      },
      "check": {
        "kind": "result_verdict",
        "source": {
          "kind": "sub_run_result",
          "ref": "result"
        },
        "pass": [
          "accept",
          "accept-with-fixes",
          "accept-with-fold-ins",
          "clean",
          "needs-followup",
          "decided",
          "NO_ISSUES_FOUND",
          "ISSUES_FOUND"
        ]
      }
    },
    {
      "id": "verify-step",
      "title": "Verify — prove the built site",
      "protocol": "explainer-verify@v1",
      "reads": ["reports/explainer/spec.json", "reports/explainer/build-result.json"],
      "routes": {
        "continue": "signoff-checkpoint-step",
        "pass": "signoff-checkpoint-step",
        "retry": "verify-step",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "verification",
      "writes": {
        "report": {
          "path": "reports/explainer/verification.json",
          "schema": "explainer.verification@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": ["overall_status", "commands"]
      }
    },
    {
      "id": "signoff-checkpoint-step",
      "title": "Sign off — operator fidelity gate and publish authorization",
      "protocol": "explainer-signoff-checkpoint@v1",
      "reads": ["reports/explainer/verification.json", "reports/explainer/build-result.json"],
      "routes": {
        "continue": "close-step",
        "pass": "close-step",
        "blocked": "close-step",
        "handoff": "@handoff",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "checkpoint",
      "policy": {
        "prompt": "Final fidelity gate. Does the built explainer teach the paper’s actual driver, honor the house style, and pass verification? Authorize publishing only if yes. The default holds — Circuit does not publish without your explicit authorization.",
        "choices": [
          {
            "id": "continue",
            "label": "Authorize publish"
          },
          {
            "id": "blocked",
            "label": "Hold — fidelity or quality not met"
          },
          {
            "id": "handoff",
            "label": "Hand off"
          }
        ],
        "safe_default_choice": "blocked"
      },
      "writes": {
        "request": "reports/checkpoints/signoff-request.json",
        "response": "reports/checkpoints/signoff-response.json"
      },
      "check": {
        "kind": "checkpoint_selection",
        "source": {
          "kind": "checkpoint_response",
          "ref": "response"
        },
        "allow": ["continue", "blocked", "handoff"]
      }
    },
    {
      "id": "close-step",
      "title": "Close — emit the explainer result",
      "protocol": "explainer-close@v1",
      "reads": [
        "reports/intake.json",
        "reports/explainer/spec.json",
        "reports/explainer/verification.json",
        "reports/explainer/build-result.json"
      ],
      "routes": {
        "complete": "@complete",
        "pass": "@complete",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "compose",
      "writes": {
        "report": {
          "path": "reports/explainer-result.json",
          "schema": "explainer.result@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": ["outcome", "summary", "evidence_pointers"]
      }
    }
  ],
  "engine_flags": {
    "binds_terminal_outcome_to_primary_result": true
  },
  "runtime_surface": {
    "primary_result": {
      "schema_name": "explainer.result@v1",
      "path": "reports/explainer-result.json"
    }
  }
}
