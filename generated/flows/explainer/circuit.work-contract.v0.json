          },
          "writes": {
            "request": "reports/checkpoints/pick-request.json",
            "response": "reports/checkpoints/pick-response.json"
          }
        },
        {
          "step_id": "build-gate-step",
          "choices": {
            "kind": "static",
            "ids": ["continue", "revise"]
          },
          "writes": {
            "request": "reports/checkpoints/build-gate-request.json",
            "response": "reports/checkpoints/build-gate-response.json"
          }
        },
        {
          "step_id": "retry-gate-step",
          "choices": {
            "kind": "static",
            "ids": ["continue", "stop"]
