    "authority": {
      "relays": [
        {
          "step_id": "hardening-step",
          "role": "reviewer",
          "writes": {
            "report": {
              "path": "reports/hardening.json",
              "schema": "explainer.hardening@v1"
            },
            "request": "reports/relay/hardening.request.json",
            "receipt": "reports/relay/hardening.receipt.txt",
            "result": "reports/relay/hardening.result.json"
          },
          "report": {
            "step_id": "hardening-step",
            "slot": "report",
            "path": "reports/hardening.json",
            "schema": "explainer.hardening@v1"
          }
        }
      ],
      "checkpoints": [
        {
          "step_id": "pick-checkpoint-step",
