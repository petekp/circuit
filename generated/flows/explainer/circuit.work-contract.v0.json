        "routes": {
          "continue": "close-step",
          "pass": "close-step",
          "blocked": "close-step",
          "handoff": "@handoff",
          "stop": "@stop"
        }
      },
      {
        "step_id": "close-step",
        "title": "Close — emit the explainer result",
        "kind": "compose",
        "executor": "orchestrator",
