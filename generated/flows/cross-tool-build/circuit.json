{
  "schema_version": "3",
  "id": "cross-tool-build",
  "version": "0.1.0",
  "purpose": "Cross-Tool Build flow: one connector proposes a feature implementation, a second adversarially reviews it, the first revises it into a spec, the second reviews the spec, and the first implements it end-to-end and verifies. The per-step worker pin routes the doer steps and the review steps to different connectors, so the two-tool split is a property of the flow.",
  "axes": {
    "allowed_depths": ["low", "medium", "high"],
    "supports_tournament": false,
    "supports_autonomous": true,
    "default": {
      "depth": "medium",
      "tournament": false,
      "tournament_n": 3,
      "autonomous": false
    }
  },
  "starts_at": "plan-step",
  "stages": [
    {
      "id": "plan-stage",
      "title": "Plan",
      "canonical": "plan",
      "steps": ["plan-step", "propose-step", "spec-step"]
    },
    {
      "id": "act-stage",
      "title": "Act",
      "canonical": "act",
      "steps": ["implement-step"]
    },
    {
      "id": "verify-stage",
      "title": "Verify",
      "canonical": "verify",
      "steps": ["verify-step"]
    },
    {
      "id": "review-stage",
      "title": "Review",
      "canonical": "review",
      "steps": ["review-proposal-step", "review-spec-step"]
    },
    {
      "id": "close-stage",
      "title": "Close",
      "canonical": "close",
      "steps": ["close-step"]
    }
  ],
  "stage_path_policy": {
    "mode": "partial",
    "omits": ["frame", "analyze"],
    "rationale": "Cross-Tool Build is a linear propose/review/spec/review/implement/verify pipeline; plan, review, act, verify, and close are the canonical stages it uses. Frame and analyze are omitted: the goal is the brief, and the doer reads the codebase as part of proposing."
  },
  "steps": [
    {
      "id": "plan-step",
      "title": "Plan the verification",
      "protocol": "cross-tool-build-plan@v1",
      "reads": [],
      "routes": {
        "continue": "propose-step",
        "pass": "propose-step",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "compose",
      "writes": {
        "report": {
          "path": "reports/cross-tool-build/plan.json",
          "schema": "cross-tool-build.plan@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": ["objective", "verification"]
      }
    },
    {
      "id": "propose-step",
      "title": "Propose how to implement the feature",
      "protocol": "cross-tool-build-propose@v1",
      "reads": [],
      "routes": {
        "continue": "review-proposal-step",
        "pass": "review-proposal-step",
        "retry": "propose-step",
        "stop": "@stop"
      },
      "executor": "worker",
      "kind": "relay",
      "role": "researcher",
      "connector": "codex",
      "writes": {
        "report": {
          "path": "reports/cross-tool-build/proposal.json",
          "schema": "cross-tool-build.proposal@v1"
        },
        "request": "reports/relay/cross-tool-build-propose.request.json",
        "receipt": "reports/relay/cross-tool-build-propose.receipt.txt",
        "result": "reports/relay/cross-tool-build-propose.result.json"
      },
      "check": {
        "kind": "result_verdict",
        "source": {
          "kind": "relay_result",
          "ref": "result"
        },
        "pass": ["accept"]
      }
    },
    {
      "id": "review-proposal-step",
      "title": "Adversarially review the proposal",
      "protocol": "cross-tool-build-review-proposal@v1",
      "reads": ["reports/cross-tool-build/proposal.json"],
      "routes": {
        "continue": "spec-step",
        "pass": "spec-step",
        "retry": "review-proposal-step",
        "stop": "@stop"
      },
      "executor": "worker",
      "kind": "relay",
      "role": "reviewer",
      "connector": "claude-code",
      "writes": {
        "report": {
          "path": "reports/cross-tool-build/proposal-review.json",
          "schema": "cross-tool-build.proposal-review@v1"
        },
        "request": "reports/relay/cross-tool-build-review-proposal.request.json",
        "receipt": "reports/relay/cross-tool-build-review-proposal.receipt.txt",
        "result": "reports/relay/cross-tool-build-review-proposal.result.json"
      },
      "check": {
        "kind": "result_verdict",
        "source": {
          "kind": "relay_result",
          "ref": "result"
        },
        "pass": ["accept", "revise"]
      }
    },
    {
      "id": "spec-step",
      "title": "Revise the proposal and write the implementation spec",
      "protocol": "cross-tool-build-spec@v1",
      "reads": [
        "reports/cross-tool-build/proposal.json",
        "reports/cross-tool-build/proposal-review.json"
      ],
      "routes": {
        "continue": "review-spec-step",
        "pass": "review-spec-step",
        "retry": "spec-step",
        "stop": "@stop"
      },
      "executor": "worker",
      "kind": "relay",
      "role": "researcher",
      "connector": "codex",
      "writes": {
        "report": {
          "path": "reports/cross-tool-build/spec.json",
          "schema": "cross-tool-build.spec@v1"
        },
        "request": "reports/relay/cross-tool-build-spec.request.json",
        "receipt": "reports/relay/cross-tool-build-spec.receipt.txt",
        "result": "reports/relay/cross-tool-build-spec.result.json"
      },
      "check": {
        "kind": "result_verdict",
        "source": {
          "kind": "relay_result",
          "ref": "result"
        },
        "pass": ["accept"]
      }
    },
    {
      "id": "review-spec-step",
      "title": "Adversarially review the spec",
      "protocol": "cross-tool-build-review-spec@v1",
      "reads": ["reports/cross-tool-build/spec.json"],
      "routes": {
        "continue": "implement-step",
        "pass": "implement-step",
        "retry": "review-spec-step",
        "stop": "@stop"
      },
      "executor": "worker",
      "kind": "relay",
      "role": "reviewer",
      "connector": "claude-code",
      "writes": {
        "report": {
          "path": "reports/cross-tool-build/spec-review.json",
          "schema": "cross-tool-build.spec-review@v1"
        },
        "request": "reports/relay/cross-tool-build-review-spec.request.json",
        "receipt": "reports/relay/cross-tool-build-review-spec.receipt.txt",
        "result": "reports/relay/cross-tool-build-review-spec.result.json"
      },
      "check": {
        "kind": "result_verdict",
        "source": {
          "kind": "relay_result",
          "ref": "result"
        },
        "pass": ["accept", "revise"]
      }
    },
    {
      "id": "implement-step",
      "title": "Implement the spec end-to-end and manually test",
      "protocol": "cross-tool-build-implement@v1",
      "reads": ["reports/cross-tool-build/spec.json", "reports/cross-tool-build/spec-review.json"],
      "routes": {
        "continue": "verify-step",
        "pass": "verify-step",
        "retry": "implement-step",
        "stop": "@stop"
      },
      "executor": "worker",
      "kind": "relay",
      "role": "implementer",
      "connector": "codex",
      "writes": {
        "report": {
          "path": "reports/cross-tool-build/implementation.json",
          "schema": "cross-tool-build.implementation@v1"
        },
        "request": "reports/relay/cross-tool-build-implement.request.json",
        "receipt": "reports/relay/cross-tool-build-implement.receipt.txt",
        "result": "reports/relay/cross-tool-build-implement.result.json"
      },
      "check": {
        "kind": "result_verdict",
        "source": {
          "kind": "relay_result",
          "ref": "result"
        },
        "pass": ["accept"]
      }
    },
    {
      "id": "verify-step",
      "title": "Run the verification",
      "protocol": "cross-tool-build-verify@v1",
      "reads": [
        "reports/cross-tool-build/plan.json",
        "reports/cross-tool-build/implementation.json"
      ],
      "routes": {
        "continue": "close-step",
        "pass": "close-step",
        "retry": "implement-step",
        "stop": "@stop"
      },
      "exhaustion_route": "continue",
      "executor": "orchestrator",
      "kind": "verification",
      "writes": {
        "report": {
          "path": "reports/cross-tool-build/verification.json",
          "schema": "cross-tool-build.verification@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": ["overall_status", "commands"]
      }
    },
    {
      "id": "close-step",
      "title": "Emit the result",
      "protocol": "cross-tool-build-close@v1",
      "reads": [
        "reports/cross-tool-build/implementation.json",
        "reports/cross-tool-build/verification.json",
        "reports/cross-tool-build/proposal-review.json",
        "reports/cross-tool-build/spec-review.json"
      ],
      "routes": {
        "complete": "@complete",
        "pass": "@complete",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "compose",
      "writes": {
        "report": {
          "path": "reports/cross-tool-build-result.json",
          "schema": "cross-tool-build.result@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": ["summary", "outcome", "verification_status", "evidence_links"]
      }
    }
  ],
  "runtime_surface": {
    "primary_result": {
      "schema_name": "cross-tool-build.result@v1",
      "path": "reports/cross-tool-build-result.json"
    }
  }
}
