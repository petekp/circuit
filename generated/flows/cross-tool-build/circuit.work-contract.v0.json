        "allowed_depths": ["low", "medium", "high"],
        "supports_tournament": false,
        "supports_autonomous": true,
        "default": {
          "depth": "medium",
          "tournament": false,
          "tournament_n": 3,
          "autonomous": false
        }
      },
      "starts_at": "plan-step"
    },
