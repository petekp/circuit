        },
        "check": {
          "kind": "result_verdict",
          "source": {
            "kind": "relay_result",
            "ref": "result"
          },
          "pass": ["accept", "accept-with-fixes", "reject"]
        },
        "routes": {
          "continue": "@complete",
          "pass": "@complete",
          "advance": "act-step",
          "close": "@stop"
        }
      }
