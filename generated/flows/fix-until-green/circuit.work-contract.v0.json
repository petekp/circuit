            "ref": "report"
          },
          "required": ["overall_status", "commands"]
        },
        "routes": {
          "continue": "judge-step",
          "pass": "judge-step",
          "revise": "judge-step",
          "stop": "@stop"
        }
      },
      {
        "step_id": "judge-step",
        "title": "Judge whether the goal is met",
        "kind": "relay",
        "executor": "worker",
        "protocol": "fix-until-green-review@v1",
        "reads": [],
        "writes": {
