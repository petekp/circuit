        },
        "check": {
          "kind": "result_verdict",
          "source": {
            "kind": "relay_result",
            "ref": "result"
          },
          "pass": ["ok"]
        },
        "routes": {
          "continue": "verify-step",
          "pass": "verify-step"
        }
      },
      {
