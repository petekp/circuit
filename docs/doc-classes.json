    { "glob": "docs/release/proofs/README.md", "class": "living" },
    {
      "glob": "docs/generated-surfaces.md",
      "class": "generated",
      "generator": "scripts/flows/emit.ts"
    },
    {
      "glob": "docs/release/*.generated.md",
