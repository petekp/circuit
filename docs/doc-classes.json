{
  "schema_version": 1,
  "entries": [
    { "glob": "docs/ideas/**", "class": "historical" },
    { "glob": "docs/learnings/**", "class": "historical" },
    { "glob": "docs/audits/**", "class": "historical" },
    { "glob": "docs/plans/**", "class": "historical" },
    { "glob": "docs/pivot/**", "class": "historical" },
    { "glob": "docs/release/proofs/runs/**", "class": "evidence" },
