{
  "schema_version": "3",
  "id": "release-note-flow",
  "version": "0.1.0",
  "purpose": "Draft release notes from a change summary.",
  "axes": {
    "allowed_depths": [
      "low",
      "medium",
      "high"
    ],
    "supports_tournament": false,
    "supports_autonomous": true,
    "default": {
      "depth": "medium",
      "tournament": false,
      "tournament_n": 3,
      "autonomous": false
    }
  },
  "starts_at": "frame-step",
  "stages": [
    {
      "id": "frame-stage",
      "title": "Frame",
      "canonical": "frame",
      "steps": [
        "frame-step"
      ]
    },
    {
      "id": "plan-stage",
      "title": "Plan",
      "canonical": "plan",
      "steps": [
        "plan-step"
      ]
    },
    {
      "id": "act-stage",
      "title": "Act",
      "canonical": "act",
      "steps": [
        "act-step"
      ]
    },
    {
      "id": "verify-stage",
      "title": "Verify",
      "canonical": "verify",
      "steps": [
        "verify-step"
      ]
    },
    {
      "id": "close-stage",
      "title": "Close",
      "canonical": "close",
      "steps": [
        "close-step"
      ]
    }
  ],
  "stage_path_policy": {
    "mode": "partial",
    "omits": [
      "analyze",
      "review"
    ],
    "rationale": "Whole grain: analyze folds into act and review folds into close; one folded work spine."
  },
  "steps": [
    {
      "id": "frame-step",
      "title": "Frame - confirm Build brief",
      "protocol": "build-frame@v1",
      "reads": [],
      "routes": {
        "continue": "plan-step",
        "pass": "plan-step",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "checkpoint",
      "policy": {
        "prompt": "Confirm the Build brief before implementation starts.",
        "choices": [
          {
            "id": "continue",
            "label": "Continue"
          }
        ],
        "safe_default_choice": "continue",
        "report_template": {
          "scope": "Make the smallest safe change that satisfies the requested goal.",
          "success_criteria": [
            "The requested behavior is implemented",
            "Verification passes",
            "Review completes without a blocking issue"
          ]
        }
      },
      "writes": {
        "request": "reports/checkpoints/frame-step-request.json",
        "response": "reports/checkpoints/frame-step-response.json",
        "report": {
          "path": "reports/build/brief.json",
          "schema": "build.brief@v1"
        }
      },
      "check": {
        "kind": "checkpoint_selection",
        "source": {
          "kind": "checkpoint_response",
          "ref": "response"
        },
        "allow": [
          "continue"
        ]
      }
    },
    {
      "id": "plan-step",
      "title": "Plan - produce Build plan",
      "protocol": "build-plan@v1",
      "reads": [
        "reports/build/brief.json"
      ],
      "routes": {
        "continue": "act-step",
        "pass": "act-step",
        "revise": "plan-step",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "compose",
      "writes": {
        "report": {
          "path": "reports/build/plan.json",
          "schema": "build.plan@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": [
          "objective",
          "verification"
        ]
      }
    },
    {
      "id": "act-step",
      "title": "Act - implementation relay",
      "protocol": "build-act@v1",
      "reads": [
        "reports/build/brief.json",
        "reports/build/plan.json"
      ],
      "routes": {
        "continue": "verify-step",
        "pass": "verify-step",
        "retry": "act-step",
        "stop": "@stop"
      },
      "skill_slots": [
        {
          "id": "build-implementation",
          "description": "A skill for implementing the planned change in the existing code style, keeping edits scoped to the plan."
        }
      ],
      "executor": "worker",
      "kind": "relay",
      "role": "implementer",
      "acceptance_criteria": {
        "checks": [
          {
            "kind": "report_field",
            "id": "changed-files-present",
            "path": [
              "changed_files"
            ],
            "predicate": "present"
          },
          {
            "kind": "report_field",
            "id": "changed-files-on-disk",
            "path": [
              "changed_files"
            ],
            "predicate": "changed_on_disk"
          },
          {
            "kind": "report_field",
            "id": "evidence-non-empty",
            "path": [
              "evidence"
            ],
            "predicate": "non_empty"
          }
        ],
        "on_failure": {
          "mode": "retry-with-feedback"
        }
      },
      "writes": {
        "report": {
          "path": "reports/build/implementation.json",
          "schema": "build.implementation@v1"
        },
        "request": "reports/relay/build-act.request.json",
        "receipt": "reports/relay/build-act.receipt.txt",
        "result": "reports/relay/build-act.result.json"
      },
      "check": {
        "kind": "result_verdict",
        "source": {
          "kind": "relay_result",
          "ref": "result"
        },
        "pass": [
          "accept"
        ]
      }
    },
    {
      "id": "verify-step",
      "title": "Verify - run Build verification",
      "protocol": "build-verify@v1",
      "reads": [
        "reports/build/plan.json",
        "reports/build/implementation.json"
      ],
      "routes": {
        "continue": "close-step",
        "pass": "close-step",
        "advance": "act-step",
        "retry": "act-step",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "verification",
      "writes": {
        "report": {
          "path": "reports/build/verification.json",
          "schema": "build.verification@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": [
          "overall_status",
          "commands"
        ]
      }
    },
    {
      "id": "close-step",
      "title": "Close - emit Build result",
      "protocol": "build-close@v1",
      "reads": [
        "reports/build/brief.json",
        "reports/build/plan.json",
        "reports/build/implementation.json",
        "reports/build/verification.json"
      ],
      "routes": {
        "complete": "@complete",
        "pass": "@complete",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "compose",
      "writes": {
        "report": {
          "path": "reports/build-result.json",
          "schema": "build.result@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": [
          "summary",
          "outcome",
          "evidence_links"
        ]
      }
    }
  ],
  "engine_flags": {
    "binds_execution_depth_to_relay_selection": true,
    "iterates_slice_loop": {
      "head_step": "act-step",
      "tail_step": "verify-step",
      "advance_route": "advance",
      "slices_from": {
        "report": "reports/build/plan.json",
        "items_path": "slices"
      },
      "max_slices": 8,
      "activate_when_depth_at_least": "high"
    }
  },
  "report_file_surfaces": {
    "build.plan@v1": {
      "timing": "before",
      "extractor": {
        "kind": "build-plan-and-slices-anticipated-file-extensions"
      }
    }
  },
  "runtime_surface": {
    "primary_result": {
      "schema_name": "build.result@v1",
      "path": "reports/build-result.json"
    }
  }
}
