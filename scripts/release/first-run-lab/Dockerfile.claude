# A Claude Code user's machine: Node 22 + the Claude Code CLI, signed out.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash newdev
USER newdev
WORKDIR /home/newdev
# Per-user npm prefix so the global install works without root, like a real
# dev box with a version manager.
RUN mkdir -p /home/newdev/.npm-global \
  && npm config set prefix /home/newdev/.npm-global \
  && npm install -g @anthropic-ai/claude-code
ENV PATH="/home/newdev/.npm-global/bin:${PATH}"
CMD ["bash"]
