# Anchored to repo root with a leading slash. Without it, gitignore
# patterns match any directory of that name at any depth — so an
# unanchored `build/` would silently shadow src/workflows/build/, an
# unanchored `dist/` would shadow any future src/.../dist/ fixture, etc.
# Same trap as the prior `build/` shadowing bug; keep all three anchored.
/node_modules/
/dist/
/build/
.DS_Store
*.log
.env
.env.local
coverage/
.vitest-cache/
.turbo/
.claude/projects/
.claude/worktrees/
# Runtime lock from the Claude Code harness (sessionId/pid/acquiredAt). Not
# a deliverable; per-machine ephemeral state.
.claude/scheduled_tasks.lock

# Tool-run state for the Circuit harness used by this project. Ephemeral
# per-machine state; nothing here is a deliverable.
.circuit/

# Local git worktrees for parallel work. Create worktrees here
# (`git worktree add .worktrees/<name> ...`), never as sibling
# directories of the checkout.
/.worktrees/

# CodeGraph local index (SQLite knowledge graph + cache). Per-machine and
# rebuildable from source; nothing here is a deliverable.
/.codegraph/

# Local-only internal documentation archive. These files can include historical
# planning notes, audit ledgers, and other material that should not ship as
# public documentation.
/docs/internal/**

# E1 experiment live-run output: worktrees, run folders, and raw stdout/stderr
# from `run-comparison.ts --live`. Per-run scratch, never a deliverable.
/experiments/e1/.runs/

# Context-pull last-mile capture scratch: the engine-built act-step prompts the
# capture harness dumps for the real-worker probes. Regenerable, never a deliverable.
/experiments/flow-lab/.capture/

# thin-envelope quality-probe scratch (throwaway, never committed)
.probe-scratch/
