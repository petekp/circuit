{
  "schema_version": "2",
  "id": "build",
  "title": "Build Schematic",
  "purpose": "Build flow. Circuit frames a requested change, plans it, relays implementation to a worker, runs verification, relays review to a separate worker, and closes with a Build result file plus evidence.",
  "status": "active",
  "starts_at": "frame-step",
  "initial_contracts": [
    "task.intake@v1",
    "route.decision@v1",
    "context.request@v1",
    "verification.plan@v1"
  ],
  "contract_aliases": [
    {
      "generic": "flow.brief@v1",
      "actual": "build.brief@v1"
    },
    {
      "generic": "context.packet@v1",
      "actual": "build.context@v1"
    },
    {
      "generic": "plan.strategy@v1",
      "actual": "build.plan@v1"
    },
    {
      "generic": "change.evidence@v1",
      "actual": "build.implementation@v1"
    },
    {
      "generic": "verification.result@v1",
      "actual": "build.verification@v1"
    },
    {
      "generic": "verification.result@v1",
      "actual": "build.baseline-snapshot@v1"
    },
    {
      "generic": "verification.result@v1",
      "actual": "build.touch-area@v1"
    },
    {
      "generic": "review.verdict@v1",
      "actual": "build.review@v1"
    },
    {
      "generic": "flow.result@v1",
      "actual": "build.result@v1"
    }
  ],
  "items": [
    {
      "id": "frame-step",
      "block": "frame",
      "title": "Frame - confirm Build brief",
      "stage": "frame",
      "input": {
        "task": "task.intake@v1",
        "route": "route.decision@v1"
      },
      "optional_inputs": [],
      "output": "build.brief@v1",
      "evidence_requirements": ["scope boundary", "constraints", "proof plan"],
      "execution": {
        "kind": "checkpoint"
      },
      "skill_slots": [],
      "routes": {
        "continue": "analyze-step",
        "stop": "@stop"
      },
      "route_overrides": {},
      "protocol": "build-frame@v1",
      "writes": {
        "report_path": "reports/build/brief.json",
        "checkpoint_request_path": "reports/checkpoints/frame-step-request.json",
        "checkpoint_response_path": "reports/checkpoints/frame-step-response.json"
      },
      "check": {
        "allow": ["continue"]
      },
      "checkpoint_policy": {
        "prompt": "Confirm the Build brief before implementation starts.",
        "choices": [
          {
            "id": "continue",
            "label": "Continue"
          }
        ],
        "safe_default_choice": "continue",
        "report_template": {
          "scope": "Make the smallest safe change that satisfies the requested goal.",
          "success_criteria": [
            "The requested behavior is implemented",
            "Verification passes",
            "Review completes without a blocking issue"
          ]
        }
      }
    },
    {
      "id": "analyze-step",
      "block": "gather-context",
      "title": "Analyze — read the code before planning",
      "stage": "analyze",
      "input": {
        "brief": "build.brief@v1",
        "request": "context.request@v1"
      },
      "optional_inputs": [],
      "output": "build.context@v1",
      "evidence_requirements": ["source list", "observations", "confidence notes"],
      "execution": {
        "kind": "relay",
        "role": "researcher"
      },
      "skill_slots": [
        {
          "id": "build-codebase-search",
          "description": "A skill for reading the codebase and tracing the call paths a change will touch before any plan is written."
        }
      ],
      "routes": {
        "continue": "plan-step",
        "retry": "analyze-step",
        "ask": "@stop",
        "stop": "@stop"
      },
      "route_overrides": {},
      "protocol": "build-analyze@v1",
      "writes": {
        "report_path": "reports/build/context.json",
        "request_path": "reports/relay/build-analyze.request.json",
        "receipt_path": "reports/relay/build-analyze.receipt.txt",
        "result_path": "reports/relay/build-analyze.result.json"
      },
      "check": {
        "pass": ["accept"]
      }
    },
    {
      "id": "plan-step",
      "block": "plan",
      "title": "Plan - produce Build plan",
      "stage": "plan",
      "input": {
        "brief": "build.brief@v1",
        "context": "build.context@v1"
      },
      "optional_inputs": [],
      "output": "build.plan@v1",
      "evidence_requirements": ["ordered steps", "risk notes", "proof strategy"],
      "execution": {
        "kind": "compose"
      },
      "skill_slots": [],
      "routes": {
        "continue": "build-baseline",
        "revise": "plan-step",
        "stop": "@stop"
      },
      "route_overrides": {},
      "protocol": "build-plan@v1",
      "writes": {
        "report_path": "reports/build/plan.json"
      },
      "check": {
        "required": ["objective", "verification"]
      }
    },
    {
      "id": "build-baseline",
      "block": "run-verification",
      "title": "Verify - snapshot pre-change git state",
      "stage": "verify",
      "input": {
        "proof": "verification.plan@v1",
        "plan": "build.plan@v1"
      },
      "optional_inputs": [],
      "output": "build.baseline-snapshot@v1",
      "evidence_requirements": ["command list", "exit status", "bounded output", "pass or fail"],
      "execution": {
        "kind": "verification"
      },
      "skill_slots": [],
      "routes": {
        "continue": "act-step",
        "stop": "@stop"
      },
      "route_overrides": {},
      "protocol": "build-baseline-snapshot@v1",
      "writes": {
        "report_path": "reports/build/baseline-snapshot.json"
      },
      "check": {
        "required": ["overall_status"]
      }
    },
    {
      "id": "act-step",
      "block": "act",
      "title": "Act - implementation relay",
      "stage": "act",
      "input": {
        "brief": "build.brief@v1",
        "plan": "build.plan@v1"
      },
      "optional_inputs": [],
      "output": "build.implementation@v1",
      "evidence_requirements": ["changed files", "change rationale", "declared follow-up proof"],
      "execution": {
        "kind": "relay",
        "role": "implementer"
      },
      "skill_slots": [
        {
          "id": "build-implementation",
          "description": "A skill for implementing the planned change in the existing code style, keeping edits scoped to the plan."
        }
      ],
      "budgets": {
        "wall_clock_ms": 7200000
      },
      "routes": {
        "continue": "verify-step",
        "retry": "act-step",
        "stop": "@stop"
      },
      "route_overrides": {},
      "protocol": "build-act@v1",
      "writes": {
        "report_path": "reports/build/implementation.json",
        "request_path": "reports/relay/build-act.request.json",
        "receipt_path": "reports/relay/build-act.receipt.txt",
        "result_path": "reports/relay/build-act.result.json"
      },
      "check": {
        "pass": ["accept"]
      },
      "acceptance_criteria": {
        "checks": [
          {
            "kind": "report_field",
            "id": "changed-files-present",
            "path": ["changed_files"],
            "predicate": "present"
          },
          {
            "kind": "report_field",
            "id": "changed-files-on-disk",
            "path": ["changed_files"],
            "predicate": "changed_on_disk"
          },
          {
            "kind": "report_field",
            "id": "evidence-non-empty",
            "path": ["evidence"],
            "predicate": "non_empty"
          }
        ],
        "on_failure": {
          "mode": "retry-with-feedback"
        }
      }
    },
    {
      "id": "verify-step",
      "block": "run-verification",
      "title": "Verify - run Build verification",
      "stage": "verify",
      "input": {
        "proof": "verification.plan@v1",
        "plan": "build.plan@v1",
        "change": "build.implementation@v1"
      },
      "optional_inputs": [],
      "output": "build.verification@v1",
      "evidence_requirements": ["command list", "exit status", "bounded output", "pass or fail"],
      "execution": {
        "kind": "verification"
      },
      "skill_slots": [],
      "routes": {
        "continue": "build-touch-area",
        "advance": "act-step",
        "retry": "act-step",
        "stop": "@stop"
      },
      "route_overrides": {},
      "protocol": "build-verify@v1",
      "writes": {
        "report_path": "reports/build/verification.json"
      },
      "check": {
        "required": ["overall_status", "commands"]
      }
    },
    {
      "id": "build-touch-area",
      "block": "run-verification",
      "title": "Verify - check git-proven touch area",
      "stage": "verify",
      "input": {
        "proof": "verification.plan@v1",
        "plan": "build.plan@v1",
        "baseline": "build.baseline-snapshot@v1",
        "change": "build.implementation@v1"
      },
      "optional_inputs": [],
      "output": "build.touch-area@v1",
      "evidence_requirements": ["command list", "exit status", "bounded output", "pass or fail"],
      "execution": {
        "kind": "verification"
      },
      "skill_slots": [],
      "routes": {
        "continue": "review-step",
        "stop": "@stop"
      },
      "route_overrides": {},
      "protocol": "build-touch-area@v1",
      "writes": {
        "report_path": "reports/build/touch-area.json"
      },
      "check": {
        "required": ["overall_status", "enforcement", "containment"]
      }
    },
    {
      "id": "review-step",
      "block": "review",
      "title": "Review - implementation review relay",
      "stage": "review",
      "input": {
        "brief": "build.brief@v1",
        "plan": "build.plan@v1",
        "change": "build.implementation@v1",
        "verification": "build.verification@v1",
        "touch_area": "build.touch-area@v1"
      },
      "optional_inputs": [],
      "output": "build.review@v1",
      "evidence_requirements": ["verdict", "findings", "confidence", "required fixes"],
      "execution": {
        "kind": "relay",
        "role": "reviewer"
      },
      "skill_slots": [
        {
          "id": "build-change-audit",
          "description": "A skill for independently auditing a change for correctness, scope creep, and regressions."
        }
      ],
      "routes": {
        "continue": "close-step",
        "retry": "act-step",
        "revise": "act-step",
        "stop": "@stop"
      },
      "route_overrides": {},
      "protocol": "build-review@v1",
      "writes": {
        "report_path": "reports/build/review.json",
        "request_path": "reports/relay/build-review.request.json",
        "receipt_path": "reports/relay/build-review.receipt.txt",
        "result_path": "reports/relay/build-review.result.json"
      },
      "check": {
        "pass": ["accept", "accept-with-fixes", "reject"]
      }
    },
    {
      "id": "close-step",
      "block": "close-with-evidence",
      "title": "Close - emit Build result",
      "stage": "close",
      "input": {
        "brief": "build.brief@v1",
        "plan": "build.plan@v1",
        "implementation": "build.implementation@v1",
        "verification": "build.verification@v1",
        "review": "build.review@v1",
        "touch_area": "build.touch-area@v1"
      },
      "optional_inputs": [],
      "output": "build.result@v1",
      "evidence_requirements": ["outcome", "evidence pointers", "residual risks", "follow-ups"],
      "execution": {
        "kind": "compose"
      },
      "skill_slots": [],
      "routes": {
        "complete": "@complete",
        "stop": "@stop"
      },
      "route_overrides": {},
      "protocol": "build-close@v1",
      "writes": {
        "report_path": "reports/build-result.json"
      },
      "check": {
        "required": ["summary", "outcome", "evidence_links"]
      }
    }
  ],
  "version": "0.1.0",
  "axes": {
    "allowed_depths": ["low", "medium", "high"],
    "supports_tournament": false,
    "supports_autonomous": true,
    "default": {
      "depth": "medium",
      "tournament": false,
      "tournament_n": 3,
      "autonomous": false
    }
  },
  "stage_path_policy": {
    "mode": "strict"
  },
  "stages": [
    {
      "canonical": "frame",
      "id": "frame-stage",
      "title": "Frame"
    },
    {
      "canonical": "analyze",
      "id": "analyze-stage",
      "title": "Analyze"
    },
    {
      "canonical": "plan",
      "id": "plan-stage",
      "title": "Plan"
    },
    {
      "canonical": "act",
      "id": "act-stage",
      "title": "Act"
    },
    {
      "canonical": "verify",
      "id": "verify-stage",
      "title": "Verify"
    },
    {
      "canonical": "review",
      "id": "review-stage",
      "title": "Review"
    },
    {
      "canonical": "close",
      "id": "close-stage",
      "title": "Close"
    }
  ],
  "engine_flags": {
    "binds_execution_depth_to_relay_selection": true,
    "binds_terminal_outcome_to_primary_result": true,
    "iterates_slice_loop": {
      "head_step": "act-step",
      "tail_step": "verify-step",
      "advance_route": "advance",
      "slices_from": {
        "report": "reports/build/plan.json",
        "items_path": "slices"
      },
      "max_slices": 8,
      "activate_when_depth_at_least": "high"
    }
  },
  "report_file_surfaces": {
    "build.plan@v1": {
      "timing": "before",
      "extractor": {
        "kind": "build-plan-and-slices-anticipated-file-extensions"
      }
    }
  }
}
