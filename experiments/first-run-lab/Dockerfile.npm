# A first-time user installing the published CLI from the live npm registry:
# Node 22 LTS, git, stock npm, nothing else. The global prefix lives under the
# unprivileged user's home so `npm install -g` works without root, the way it
# does on a normal developer machine.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash newdev
USER newdev
WORKDIR /home/newdev
ENV NPM_CONFIG_PREFIX=/home/newdev/.npm-global
ENV PATH=/home/newdev/.npm-global/bin:$PATH
CMD ["bash"]
