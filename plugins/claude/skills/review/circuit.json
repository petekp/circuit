{
  "schema_version": "3",
  "id": "review",
  "version": "0.1.0",
  "purpose": "Review flow: frame the audit scope, relay independent review to a reviewer, and close with a verdict report. The schematic uses a compact Intake, Independent Audit, and Verdict shape because Review is audit-only and does not implement or verify a change.",
  "axes": {
    "allowed_depths": ["medium"],
    "supports_tournament": false,
    "supports_autonomous": false,
    "default": {
      "depth": "medium",
      "tournament": false,
      "tournament_n": 3,
      "autonomous": false
    }
  },
  "starts_at": "intake-step",
  "stages": [
    {
      "id": "intake-stage",
      "title": "Intake",
      "canonical": "frame",
      "steps": ["intake-step"]
    },
    {
      "id": "audit-stage",
      "title": "Independent Audit",
      "canonical": "analyze",
      "steps": ["audit-step"]
    },
    {
      "id": "verdict-stage",
      "title": "Verdict",
      "canonical": "close",
      "steps": ["verdict-step"]
    }
  ],
  "stage_path_policy": {
    "mode": "partial",
    "omits": ["plan", "act", "verify", "review"],
    "rationale": "Review is an audit-only flow: Intake frames the scope, Independent Audit performs the reviewer relay, and Verdict aggregates findings. There is no planning stage, no implementation/action stage, no verification rerun, and no nested review stage in this narrowed variant."
  },
  "steps": [
    {
      "id": "intake-step",
      "title": "Intake — resolve review scope",
      "protocol": "review-intake@v1",
      "reads": [],
      "routes": {
        "continue": "audit-step",
        "pass": "audit-step",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "compose",
      "writes": {
        "report": {
          "path": "reports/review-intake.json",
          "schema": "review.intake@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": ["scope", "evidence"]
      }
    },
    {
      "id": "audit-step",
      "title": "Independent Audit — reviewer relay",
      "protocol": "review-audit@v1",
      "reads": ["reports/review-intake.json"],
      "routes": {
        "continue": "verdict-step",
        "pass": "verdict-step",
        "retry": "audit-step",
        "stop": "@stop"
      },
      "skill_slots": [
        {
          "id": "review-independent-audit",
          "description": "A skill for independently auditing code or a change for correctness, regressions, and scope creep."
        }
      ],
      "executor": "orchestrator",
      "kind": "fanout",
      "branches": {
        "kind": "dynamic",
        "source_report": "reports/review-intake.json",
        "items_path": "units",
        "template": {
          "branch_id": "$item.unit_id",
          "execution": {
            "kind": "relay",
            "role": "reviewer",
            "goal": "$item.goal",
            "report_schema": "review.unit-verdict@v1",
            "item_evidence_field": "contents",
            "inherit_step_reads": false,
            "provenance_field": "unit_id",
            "max_attempts": 2
          }
        },
        "max_branches": 24
      },
      "concurrency": {
        "kind": "bounded",
        "max": 4
      },
      "on_child_failure": "continue-others",
      "writes": {
        "branches_dir": "reports/review-units",
        "aggregate": {
          "path": "reports/review-audit-aggregate.json",
          "schema": "review.audit-aggregate@v1"
        }
      },
      "check": {
        "kind": "fanout_aggregate",
        "source": {
          "kind": "fanout_results",
          "ref": "aggregate"
        },
        "join": {
          "policy": "aggregate-any"
        },
        "verdicts": {
          "admit": ["NO_ISSUES_FOUND", "ISSUES_FOUND"]
        }
      }
    },
    {
      "id": "verdict-step",
      "title": "Verdict — emit review.result",
      "protocol": "review-verdict@v1",
      "reads": ["reports/review-intake.json", "reports/review-audit-aggregate.json"],
      "routes": {
        "complete": "@complete",
        "pass": "@complete",
        "stop": "@stop"
      },
      "executor": "orchestrator",
      "kind": "compose",
      "writes": {
        "report": {
          "path": "reports/review-result.json",
          "schema": "review.result@v1"
        }
      },
      "check": {
        "kind": "schema_sections",
        "source": {
          "kind": "report",
          "ref": "report"
        },
        "required": ["scope", "findings", "verdict"]
      }
    }
  ],
  "engine_flags": {
    "relay_uses_prompt_only_context": true
  },
  "runtime_surface": {
    "primary_result": {
      "schema_name": "review.result@v1",
      "path": "reports/review-result.json"
    }
  }
}
